													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "Parquet_sink",
											"type": "DatasetReference",
											"parameters": {
												"directory": {
													"value": "@concat(item().table_name_source,'/Date_Part=',formatDateTime(utcNow(),'yyyy-MM-dd'))",
													"type": "Expression"
												},
												"filename": {
													"value": "@item().File_name_sink",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
